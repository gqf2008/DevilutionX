    },
    {
      "name":"ARGB8888",
      "bits_per_pixel":32,
      "layout":"A8 R8 G8 B8",
      "usage":"Alternative 32-bit layout"
    },
    {
      "name":"ABGR8888",
      "bits_per_pixel":32,
      "layout":"A8 B8 G8 R8",
      "usage":"SDL default on little-endian"
    },
    {
      "name":"RGB888",
      "bits_per_pixel":24,
      "layout":"R8 G8 B8",
      "usage":"24-bit no alpha"
    },
    {
      "name":"RGB565",
      "bits_per_pixel":16,
      "layout":"R5 G6 B5",
      "usage":"16-bit color"
    },
    {
      "name":"PAL8",
      "bits_per_pixel":8,
      "layout":"Index8",
      "usage":"8-bit palettized"
    }
  ],
  "pcx_format":
  {
    "header_size":128,
    "magic":10,
    "version":5,
    "encoding":1,
    "palette_offset":-769,
    "palette_marker":12,
    "header_fields":
    [
      {
        "name":"magic",
        "offset":0,
        "size":1,
        "description":"Always 10 (0x0A)"
      },
      {
        "name":"version",
        "offset":1,
        "size":1,
        "description":"PCX version (5 = 3.0)"
      },
      {
        "name":"encoding",
        "offset":2,
        "size":1,
        "description":"1 = RLE"
      },
      {
        "name":"bpp",
        "offset":3,
        "size":1,
        "description":"Bits per pixel per plane"
      },
      {
        "name":"xmin",
        "offset":4,
        "size":2,
        "description":"Image bounds left"
      },
      {
        "name":"ymin",
        "offset":6,
        "size":2,
        "description":"Image bounds top"
      },
      {
        "name":"xmax",
        "offset":8,
        "size":2,
        "description":"Image bounds right"
      },
      {
        "name":"ymax",
        "offset":10,
        "size":2,
        "description":"Image bounds bottom"
      },
      {
        "name":"hdpi",
        "offset":12,
        "size":2,
        "description":"Horizontal DPI"
      },
      {
        "name":"vdpi",
        "offset":14,
        "size":2,
        "description":"Vertical DPI"
      },
      {
        "name":"colormap",
        "offset":16,
        "size":48,
        "description":"16-color palette"
      },
      {
        "name":"reserved",
        "offset":64,
        "size":1,
        "description":"Reserved byte"
      },
      {
        "name":"nplanes",
        "offset":65,
        "size":1,
        "description":"Number of color planes"
      },
      {
        "name":"bytes_per_line",
        "offset":66,
        "size":2,
        "description":"Bytes per scanline"
      },
      {
        "name":"palette_info",
        "offset":68,
        "size":2,
        "description":"Palette type"
      }
    ]
  },
  "clx_format":
  {
    "description":"DevilutionX native sprite format",
    "structure":
    ["uint32_t num_groups", "uint32_t frame_offsets[num_frames+1]", "for each frame: ClxFrame data"
    ],
    "pixel_commands":
    [
      {
        "name":"transparent",
        "byte_range_start":0,
        "byte_range_end":127,
        "meaning":"Skip N transparent pixels"
      },
      {
        "name":"fill",
        "byte_range_start":128,
        "byte_range_end":190,
        "meaning":"Fill N pixels with next byte color"
      },
      {
        "name":"pixels",
        "byte_range_start":191,
        "byte_range_end":255,
        "meaning":"Copy N raw pixel bytes"
      }
    ]
  },
